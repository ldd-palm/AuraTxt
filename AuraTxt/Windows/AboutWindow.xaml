<Window x:Class="AuraTxt.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AuraTxt" Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceElevated}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
      <Image Source="pack://application:,,,/Resources/aruatxt_logo.png" Width="48" Height="48" Margin="0,0,12,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="AuraTxt" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
        <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="RuntimeText" Grid.Row="1" FontSize="12"
               Foreground="{DynamicResource TextSecondary}"
               HorizontalAlignment="Center" Margin="0,0,0,12"/>

    <TextBlock x:Name="UpdateStatusText" Grid.Row="2" FontSize="13"
               HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"
               Foreground="{DynamicResource TextPrimary}"
               MouseLeftButtonUp="UpdateStatusText_Click"/>

    <CheckBox x:Name="AutoUpdateCheckBox" Grid.Row="3"
              Content="Automatically check for updates on startup"
              Foreground="{DynamicResource TextPrimary}"
              Margin="0,0,0,16"
              Checked="AutoUpdateCheckBox_Changed" Unchecked="AutoUpdateCheckBox_Changed"/>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Path Grid.Column="0"
            Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center"
            Fill="{DynamicResource TextPrimary}" Cursor="Hand"
            MouseLeftButtonUp="GitHubIcon_Click" ToolTip="GitHub"/>
      <TextBlock Grid.Column="2" Text="Releases" VerticalAlignment="Center" Margin="12,0"
                 Foreground="{DynamicResource Accent}" Cursor="Hand"
                 TextDecorations="Underline"
                 MouseLeftButtonUp="ReleasesLink_Click"/>
      <Button Grid.Column="3" x:Name="CloseBtn" Content="Close" Width="70" Height="28" Click="Close_Click"/>
    </Grid>
  </Grid>
</Window>
