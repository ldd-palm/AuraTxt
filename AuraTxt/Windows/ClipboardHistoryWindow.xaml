<Window x:Class="AuraTxt.Windows.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AuraTxt.Resources"
        Title="{x:Static res:Strings.ClipHistory_Title}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Width="460" Height="420" MinWidth="320" MinHeight="200"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!-- Ditto-style: no title bar (Esc / clicking away closes it), a small × in the corner,
       row numbers as a faint gutter label, alternating rows, accent bar on the selection. -->
  <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Divider}"
          BorderThickness="1" CornerRadius="4" Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                        Opacity="{DynamicResource ShadowOpacity}"
                        Color="Black"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="22"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Row="0" Grid.Column="0">
        <!-- Fills the resizable window; rows beyond what fits scroll. -->
        <ListBox x:Name="HistoryList" AlternationCount="2"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 KeyboardNavigation.TabNavigation="None"
                 MouseDoubleClick="HistoryList_MouseDoubleClick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Height" Value="30"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent">
                      <DockPanel LastChildFill="True">
                        <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" Background="Transparent"/>
                        <ContentPresenter VerticalAlignment="Stretch"/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitleBarFill}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnFillHover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CmbHighlight}"/>
                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Width="14" Margin="2,2,0,0" Text="{Binding Number}"
                           FontSize="9" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyLabel" Text="{x:Static res:Strings.ClipHistory_Empty}"
                   Foreground="{DynamicResource TextTertiary}" Margin="14,12"
                   Visibility="Collapsed"/>
      </Grid>

      <Button Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
              Width="18" Height="18" Content="✕" FontSize="11"
              Foreground="{DynamicResource TextTertiary}" Cursor="Hand" Click="CloseBtn_Click">
        <!-- Own template: the default Button chrome shows the system (blue) hover, not the theme. -->
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnFillHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <!-- Decorative vertical label under the close button: "AuraTxt - Ver3.0", rotated 90°,
           engraved (a 1px light highlight behind a dim front layer), version in italic.
           Inlines (with the italic version) are filled in code-behind. -->
      <Grid Grid.Row="0" Grid.Column="1" Margin="0,26,0,8"
            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <!-- FontSize is larger than the 22px column; LineHeight + BlockLineHeight clamp the
             rotated line box to 18px so the glyphs grow without the strip overflowing. -->
        <TextBlock x:Name="VerLabelBack" FontFamily="Bahnschrift, Segoe UI" FontSize="16" FontWeight="SemiBold"
                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#73FFFFFF">
          <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
          <TextBlock.RenderTransform><TranslateTransform X="1" Y="1"/></TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="VerLabelFront" FontFamily="Bahnschrift, Segoe UI" FontSize="16" FontWeight="SemiBold"
                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextTertiary}">
          <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
        </TextBlock>
      </Grid>

      <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
              Background="{DynamicResource TitleBarFill}">
        <Grid Margin="6,4">
          <TextBox x:Name="SearchBox" IsTabStop="False"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource TextPrimary}" Padding="20,3,4,3"
                   TextChanged="SearchBox_TextChanged"/>
          <TextBlock Text="🔍" FontSize="11" Margin="2,0,0,0" IsHitTestVisible="False"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
          <TextBlock x:Name="SearchHint" Text="{x:Static res:Strings.ClipHistory_SearchHint}"
                     Foreground="{DynamicResource TextTertiary}" Margin="22,0,0,0" IsHitTestVisible="False"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
